# ============================================================
# AI Workforce Map — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# === Supabase ===
# Get from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://rpqxsvqxwhzymnujmyun.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# === LLM APIs ===
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=<your-openai-key>

# Anthropic (optional — used by skeptic grader if configured)
ANTHROPIC_API_KEY=<your-anthropic-key>

# === Inngest ===
# Get from: https://app.inngest.com > Your App > Keys
INNGEST_EVENT_KEY=<your-inngest-event-key>
INNGEST_SIGNING_KEY=<your-inngest-signing-key>

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
